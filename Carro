#include <16f887.h>
// Fusibles configurados con NOMCLR y NOBROWNOUT para evitar reinicios por ruido de los motores
#fuses HS, NOWDT, NOPROTECT, NOLVP, NOMCLR, NOBROWNOUT
#use delay(clock=20000000)

// Optimización I/O para escritura directa en registros
#use fast_io(B)
#use fast_io(D)

// Asignación directa de registros de puertos
#byte puerto_b = 6
#byte puerto_d = 8
void main()
{
   // 1. Desactivar entradas analógicas y comparadores para lecturas digitales puras
   setup_adc_ports(NO_ANALOGS);
   setup_adc(ADC_OFF);
   setup_comparator(NC_NC_NC_NC);

   // 2. Configuración de direcciones de los puertos
   set_tris_d(0x0F); // 00001111b -> RD0, RD1, RD2 y RD3 como ENTRADAS (TCRT5000)
   set_tris_b(0x00); // 00000000b -> RB0 a RB7 como SALIDAS (Driver L298N)

   puerto_b = 0x00;  // Estado inicial: Todos los motores apagados (0V)

   while(TRUE)
   {
      // -----------------------------------------------------------------------
      // TABLA DE ESTADOS TCRT5000:
      // Ambos LEDs Encendidos (Sobre la mesa) = Entrada PIN en 0
      // Solo LED PWR Encendido (Elevado/Sin mesa) = Entrada PIN en 1
      // -----------------------------------------------------------------------
      //if(resistencia == 0){]
      // CONDICIÓN PRINCIPAL: Los 4 sensores detectan la mesa (0, 0, 0, 0)
      if(input(PIN_D0) == 0 && input(PIN_D1) == 0 && input(PIN_D2) == 0 && input(PIN_D3) == 0)
      {
        puerto_b = 0xAA;  
      }
       // cadso dos sensores
       else if(input(PIN_D0) == 1 && input(PIN_D1) == 1 && input(PIN_D2) == 0 && input(PIN_D3) == 0)
      {
       puerto_b = 0x55; // 10100101b -> Giro a la derecha
       delay_ms(10);
       puerto_b = 0x99;
       delay_ms(10);
      }
      // CASO 1: Sensor RD0 se eleva (1) mientras los demás están en la mesa (0, 0, 0)
      else if(input(PIN_D0) == 1 && input(PIN_D1) == 0 && input(PIN_D2) == 0 && input(PIN_D3) == 0)
      {
         
         puerto_b = 0x55; 
         delay_ms(10);
       puerto_b = 0x99;
       delay_ms(10);
      }
      // CASO 2: Sensor RD1 se eleva (1) mientras los demás están en la mesa (0, 0, 0)
      else if(input(PIN_D0) == 0 && input(PIN_D1) == 1 && input(PIN_D2) == 0 && input(PIN_D3) == 0)
      {
         puerto_b = 0x55; // 10100101b -> Giro a la derecha
         delay_ms(10);
       puerto_b = 0x99;
       delay_ms(10);
      }
       // cadso dos sensores
       else if(input(PIN_D0) == 0 && input(PIN_D1) == 0 && input(PIN_D2) == 1 && input(PIN_D3) == 1)
      {
         puerto_b = 0xAA; // 10100101b -> Giro a la derecha
         delay_ms(10);
       puerto_b = 0x66;
       delay_ms(10);
      }
      // CASO 3: Sensor RD2 se eleva (1) mientras los demás están en la mesa (0, 0, 0)
      else if(input(PIN_D0) == 0 && input(PIN_D1) == 0 && input(PIN_D2) == 1 && input(PIN_D3) == 0)
      {
         puerto_b = 0xAA; // 01011010b -> Giro a la izquierda
         delay_ms(10);
       puerto_b = 0x66;
       delay_ms(10);
      }
      // ELEVADO TOTAL O CUALQUIER OTRA COMBINACIÓN DE SEGURIDAD
      else if(input(PIN_D0) == 0 && input(PIN_D1) == 0 && input(PIN_D2) == 0 && input(PIN_D3) == 1)
      {
         puerto_b = 0xAA; // 01011010b -> Giro a la izquierda
         delay_ms(10);
         puerto_b = 0x66;
         delay_ms(10);
      }
      
      else
      {
         puerto_b = 0x00; // 00000000b -> Apaga todos los motores
      }

      delay_ms(10); // Estabilización de lectura de las entradas
   }
}
