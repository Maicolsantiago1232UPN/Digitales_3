#include <16f887.h>
#fuses HS,NOWDT,NOPROTECT,NOLVP
#use delay(clock=20000000)
#byte puerto_a = 5
#byte puerto_b = 6
#byte puerto_c = 7
#byte puerto_d = 8
#byte puerto_e = 9

void main()
{
   setup_adc_ports(NO_ANALOGS);
   setup_adc(ADC_OFF);
   setup_comparator(NC_NC_NC_NC);

   // Configurar TODO el Puerto D como Salidas
   set_tris_d(0xFF);
   set_tris_b(0x00); 

   while(TRUE)
   {
   if(input(PIN_D0)== 1 || input(PIN_D1) == 1 || input(PIN_D2) == 1 || input(PIN_D3) == 1)
   {
    puerto_b = 0xAA;
    delay_ms(1000);
   } //if_0
   if(input(PIN_D0)== 0 || input(PIN_D1) == 0 || input(PIN_D2) == 0 || input(PIN_D3) == 0)
   {
    puerto_b = 0x00;
    delay_ms(1000);
   } //if_1
   
   } // while
} // main
